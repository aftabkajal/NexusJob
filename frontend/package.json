{
  "name": "nexusjob-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:tokens": "stylelint \"src/**/*.css\"",
    "test": "vitest",
    "generate:api": "nswag run nswag.json",
    "test:fsd-gate": "node scripts/check-fsd-gate.mjs",
    "test:api-import-gate": "node scripts/check-api-import-gate.mjs",
    "test:tokens-gate": "node scripts/check-tokens-gate.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.1",
    "nswag": "14.7.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
