<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Identity bounded-context module. Story 1.1: wiring-only stub (no features,
    no persistence, no auth). May reference other modules' *.Contracts only
    (AD-1); the Host is the only project allowed to reference this one (AD-10).
  -->
  <PropertyGroup>
    <RootNamespace>NexusJob.Modules.Identity</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Identity owns its own identity-schema persistence and migration history (AD-5, AD-7). -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusJob.Modules.Identity.Contracts\NexusJob.Modules.Identity.Contracts.csproj" />
  </ItemGroup>

</Project>
