<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JobPostings bounded-context module. Story 2.1a: its own job_postings-schema
    persistence and the POST /api/job-postings create endpoint. May reference
    other modules' *.Contracts only (AD-1); only the Host references this
    project (AD-10).
  -->
  <PropertyGroup>
    <RootNamespace>NexusJob.Modules.JobPostings</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- JobPostings owns its own job_postings-schema persistence and migration history (AD-5, AD-7). -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusJob.Modules.JobPostings.Contracts\NexusJob.Modules.JobPostings.Contracts.csproj" />
    <!--
      Cross-module read of the owning Company's display name goes through
      Identity's published Contract (AD-1 / AD-5 / AD-19), never the identity
      schema. A .Contracts reference only - the ArchUnitNET boundary gates permit
      any *.Contracts edge.
    -->
    <ProjectReference Include="..\NexusJob.Modules.Identity.Contracts\NexusJob.Modules.Identity.Contracts.csproj" />
  </ItemGroup>

</Project>
