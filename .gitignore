# Build output
**/bin/
**/obj/
**/dist/
**/dist-ssr/

# The SPA build is copied into the Host's wwwroot at image-build time; never committed.
backend/NexusJob.Host/wwwroot/

# Build-time OpenAPI document (spec 1.3b-i): regenerated on every Host build and
# consumed by NSwag. Only the generated TypeScript client is committed; CI
# regenerates this file and fails on client drift.
backend/NexusJob.Host/openapi/

# Node
**/node_modules/
*.tsbuildinfo
.eslintcache

# Secrets & local config - nothing secret is committed
.env
.env.*
!.env.example
*.user
*.suo
appsettings.*.local.json

# IDE / OS
.vs/
.idea/
.DS_Store
*.swp
